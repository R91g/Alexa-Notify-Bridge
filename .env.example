# Copy this file as .env and fill in your real credentials:
#   cp .env.example .env
#
# NEVER push the .env file to a public repository.

# ─── Alexa Skill Credentials ─────────────────────────────────────────────────
# Find them at: Alexa Developer Console → Your Skill → Build → Permissions
ALEXA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxx
ALEXA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Local API Security ──────────────────────────────────────────────────────
# (Optional but recommended) Password to protect your local API from intruders.
# If set, you must include it in the "x-api-key" header of your POST requests.
# API_KEY=my_secret_password

# ─── Amazon Alexa API Region ─────────────────────────────────────────────────
# Uncomment the URL that matches your region. Default: Europe (EU).
# PROACTIVE_EVENTS_URL=https://api.amazonalexa.com/v1/proactiveEvents/stages/development       # North America (NA)
PROACTIVE_EVENTS_URL=https://api.eu.amazonalexa.com/v1/proactiveEvents/stages/development      # Europe (EU)
# PROACTIVE_EVENTS_URL=https://api.fe.amazonalexa.com/v1/proactiveEvents/stages/development    # Far East (FE)

# ─── Log Level ────────────────────────────────────────────────────────────────
# Possible values: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# LOG_LEVEL=INFO
